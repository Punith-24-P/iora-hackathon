# AIORA HACKATHON 2026 — ENVIRONMENT CONFIGURATION

# Administrator Initial Credentials (Set your own secure credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_secret_password
ADMIN_JWT_SECRET=generate_a_random_secure_secret_key_here

# Public Website URL (Used for generating the dynamic Website Registration QR Code)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Event Defaults
EVENT_FEE_INR=400
EVENT_DATE=2026-11-05
EVENT_TIMEZONE=Asia/Kolkata

# Optional: Supabase Integration (Leave empty to use built-in high-performance SQLite database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
